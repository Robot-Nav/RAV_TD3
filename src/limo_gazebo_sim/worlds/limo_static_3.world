<?xml version="1.0"?>
<sdf version='1.7'>
  <world name='default'>
    <light name='sun' type='directional'>
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 -0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <model name='ground_plane'>
      <static>1</static>
      <link name='link'>
        <collision name='collision'>
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface><contact><collide_bitmask>65535</collide_bitmask><ode/></contact><friction><ode><mu>100</mu><mu2>50</mu2></ode><torsional><ode/></torsional></friction><bounce/></surface>
          <max_contacts>10</max_contacts>
        </collision>
        <visual name='visual'>
          <cast_shadows>0</cast_shadows>
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>
    <physics type='ode'>
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>100</real_time_update_rate>
      <ode><solver><type>quick</type><iters>150</iters><precon_iters>0</precon_iters><sor>1.4</sor><use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling></solver><constraints><cfm>1e-05</cfm><erp>0.2</erp><contact_max_correcting_vel>2000</contact_max_correcting_vel><contact_surface_layer>0.01</contact_surface_layer></constraints></ode>
    </physics>


    <!-- ===== 静态障碍物 ===== -->
    <model name='box_1'><static>1</static><link name='link'><collision name='collision'><geometry><box><size>2.5 1.2 1.0</size></box></geometry><surface><contact><ode/></contact></surface></collision><visual name='visual'><geometry><box><size>2.5 1.2 1.0</size></box></geometry><material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual></link><pose>3 3 0.5 0 0 0</pose></model>
    <model name='box_2'><static>1</static><link name='link'><collision name='collision'><geometry><box><size>2 2 1.0</size></box></geometry><surface><contact><ode/></contact></surface></collision><visual name='visual'><geometry><box><size>2 2 1.0</size></box></geometry><material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material></visual></link><pose>-5 3 0.5 0 0 -0.78</pose></model>
    <model name='cylinder_1'><static>1</static><link name='link'><collision name='collision'><geometry><cylinder><radius>0.2</radius><length>1.5</length></cylinder></geometry><surface><contact><ode/></contact></surface></collision><visual name='visual'><geometry><cylinder><radius>0.2</radius><length>1.5</length></cylinder></geometry><material><ambient>0.8 0.6 0.2 1</ambient><diffuse>0.9 0.7 0.3 1</diffuse></material></visual></link><pose>5 -3 0.75 0 0 0</pose></model>
    <model name='cylinder_2'><static>1</static><link name='link'><collision name='collision'><geometry><cylinder><radius>0.25</radius><length>1.5</length></cylinder></geometry><surface><contact><ode/></contact></surface></collision><visual name='visual'><geometry><cylinder><radius>0.25</radius><length>1.5</length></cylinder></geometry><material><ambient>0.9 0.5 0.2 1</ambient><diffuse>0.95 0.6 0.3 1</diffuse></material></visual></link><pose>-10 1 0.75 0 0 0</pose></model>
    <model name='barrier_1'><static>1</static><link name='link'><collision name='collision'><geometry><box><size>3 0.8 0.6</size></box></geometry><surface><contact><ode/></contact></surface></collision><visual name='visual'><geometry><box><size>3 0.8 0.6</size></box></geometry><material><ambient>0.5 0.5 0.3 1</ambient><diffuse>0.6 0.6 0.4 1</diffuse></material></visual></link><pose>10 0 0.3 0 0 0</pose></model>
    <model name='pillar_1'><static>1</static><link name='link'><collision name='collision'><geometry><box><size>0.3 0.3 2.0</size></box></geometry><surface><contact><ode/></contact></surface></collision><visual name='visual'><geometry><box><size>0.3 0.3 2.0</size></box></geometry><material><ambient>0.35 0.35 0.45 1</ambient><diffuse>0.45 0.45 0.55 1</diffuse></material></visual></link><pose>8 5 1.0 0 0 0</pose></model>

    <!-- ===== 动态障碍物（移动方块） ===== -->
    <model name='moving_obstacle_1'>
      <static>0</static>
      <link name='link_0'>
        <pose>0 0 0 0 0 0</pose>
        <inertial><mass>10</mass><inertia><ixx>0.5</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.5</iyy><iyz>0</iyz><izz>0.5</izz></inertia></inertial>
        <collision name='collision'>
          <geometry><box><size>2 1 0.8</size></box></geometry>
          <surface><contact><ode/></contact></surface>
          <max_contacts>10</max_contacts>
        </collision>
        <visual name='visual'>
          <geometry><box><size>2 1 0.8</size></box></geometry>
          <material><ambient>0.8 0.2 0.2 1</ambient><diffuse>0.9 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
      <pose>-8 4.5 0.4 0 0 0</pose>
    </model>
    <model name='moving_obstacle_2'>
      <static>0</static>
      <link name='link_0'>
        <pose>0 0 0 0 0 0</pose>
        <inertial><mass>10</mass><inertia><ixx>0.5</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.5</iyy><iyz>0</iyz><izz>0.5</izz></inertia></inertial>
        <collision name='collision'>
          <geometry><box><size>2 1 0.8</size></box></geometry>
          <surface><contact><ode/></contact></surface>
          <max_contacts>10</max_contacts>
        </collision>
        <visual name='visual'>
          <geometry><box><size>2 1 0.8</size></box></geometry>
          <material><ambient>0.8 0.2 0.2 1</ambient><diffuse>0.9 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
      <pose>-8 -1 0.4 0 0 0</pose>
    </model>
    <model name='moving_obstacle_3'>
      <static>0</static>
      <link name='link_0'>
        <pose>0 0 0 0 0 0</pose>
        <inertial><mass>10</mass><inertia><ixx>0.5</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.5</iyy><iyz>0</iyz><izz>0.5</izz></inertia></inertial>
        <collision name='collision'>
          <geometry><box><size>1.8 0.9 0.7</size></box></geometry>
          <surface><contact><ode/></contact></surface>
          <max_contacts>10</max_contacts>
        </collision>
        <visual name='visual'>
          <geometry><box><size>1.8 0.9 0.7</size></box></geometry>
          <material><ambient>0.9 0.4 0.1 1</ambient><diffuse>1.0 0.5 0.2 1</diffuse></material>
        </visual>
      </link>
      <pose>-8 -3.5 0.35 0 0 0</pose>
    </model>
  </world>
</sdf>
